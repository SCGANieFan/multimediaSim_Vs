# ==================
# better prefix
# ==================
parse_git_branch() {
    CURRENT_BRANCH=$(git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* //')
    if [[ $CURRENT_BRANCH == "" ]]; then
        CURRENT_BRANCH="\e[5m\e[31mno repository\e[0m"
    else
        CURRENT_BRANCH="\e[36m$CURRENT_BRANCH\e[0m"
    fi
    echo -e $CURRENT_BRANCH
}

ARROW="→"
